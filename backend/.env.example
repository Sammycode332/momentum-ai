# Backend environment template
#
# Neon Auth verification uses public signing keys from JWKS and pins the issuer.
NEON_AUTH_JWKS_URL=
NEON_AUTH_BASE_URL=
#
# Copy the PostgreSQL connection URI for the Neon development branch and role.
DATABASE_URL=
#
# Backend only. Configure a Gemini project approved for the planning data sent to it.
GEMINI_API_KEY=
# Required. Choose a model available to your Gemini project.
GEMINI_MODEL=
# Restricted worker login, a member of momentum_scheduler; never use momentum_app.
REMINDER_DATABASE_URL=
# Push is optional. Generate and store private keys securely; never commit real values.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
#
# Do not commit real values, credentials, database URLs, or provider API keys.
