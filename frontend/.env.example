# Frontend environment template
#
# The Neon Auth URL is public browser configuration and must end in /auth.
VITE_NEON_AUTH_URL=
# Optional public support contact. No contact is invented when omitted.
VITE_SUPPORT_EMAIL=
# Enable only after configuring and verifying Google OAuth in Neon Auth.
VITE_GOOGLE_SIGN_IN_ENABLED=false
#
# Do not place credentials, AI API keys, database URLs, or tokens here.
